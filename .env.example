# Copy to .env.local only when filling in real connection settings.
# .env.local is ignored and never part of the public game build.
# Supabase developer login uses `npm run connect` and native credential storage.
# A connected assistant plugin and a logged-in CLI are separate connections.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public testnet RPC; development reads do not need a wallet or private key.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Prefer the hidden prompt in `npm run connect` for this secret.
PINATA_JWT=
PINATA_GATEWAY=
