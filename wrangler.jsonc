{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "mythseal",
  "main": "server/account-api.mjs",
  "account_id": "cf4198e651bf3009877d49f688c9d88e",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "mythseal.com", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://mythseal.com",
    "SUPABASE_URL": "https://puiuevggytoxyyearkcq.supabase.co",
    "OTP_ENABLED": "true"
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "26092101", "simple": { "limit": 5, "period": 60 } },
    { "name": "BACKUP_RATE_LIMIT", "namespace_id": "26092102", "simple": { "limit": 10, "period": 60 } }
  ]
}
